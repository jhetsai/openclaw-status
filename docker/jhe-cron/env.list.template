# JHE Cron Backup Container - 環境變數設定
# 複製此檔案為 env.list 並填入實際值
# 啟動時: docker run --env-file env.list ...

# R2 Cloudflare
R2_ACCESS_KEY=your_r2_access_key_here
R2_SECRET_KEY=your_r2_secret_key_here

# Finnhub（美股報價）
FINNHUB_KEY=your_finnhub_key_here

# CWA API（台灣中央氣象署）
CWA_API_KEY=your_cwa_api_key_here

# WeatherAPI
WEATHER_API_KEY=your_weatherapi_key_here

# Windy
WINDY_KEY=your_windy_key_here
WINDY_PWD=your_windy_password_here
