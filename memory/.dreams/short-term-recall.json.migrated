    "memory:memory/.dreams/session-corpus/2026-05-10.txt:86:86": {
      "key": "memory:memory/.dreams/session-corpus/2026-05-10.txt:86:86",
      "path": "memory/.dreams/session-corpus/2026-05-10.txt",
      "startLine": 86,
      "endLine": 86,
      "source": "memory",
      "snippet": "User: 對了 我多加一片100W的太陽能版 這樣可以滿足啊一整天 耗電電量50W 使用一整天？ 就白天有餘力幫電池充飽電 晚上可以持續用到白天 不需要擔心電量不足",
      "recallCount": 0,
      "dailyCount": 1,
      "groundedCount": 0,
      "totalScore": 0.58,
      "maxScore": 0.58,
      "firstRecalledAt": "2026-05-12T19:00:00.903Z",
      "lastRecalledAt": "2026-05-12T19:00:00.903Z",
      "queryHashes": [
        "0bd2888cfb05"
      ],
      "recallDays": [
