    "memory:memory/.dreams/session-corpus/2026-05-10.txt:87:87": {
      "key": "memory:memory/.dreams/session-corpus/2026-05-10.txt:87:87",
      "path": "memory/.dreams/session-corpus/2026-05-10.txt",
      "startLine": 87,
      "endLine": 87,
      "source": "memory",
      "snippet": "Assistant: 200W → 300W 的配置，升級不少。來幫你算一下： --- ## ⚡ 負載需求 | 項目 | 數值 | |------|------| | 負載功率 | 50W | | 全天需求 | 50W × 24h = **1,200 Wh/天** | --- ## ☀️ 發電估算（300W 面板） | 時段 | 發電 | |------|------| | 強光（中午，约 5h） | ~250-270W avg → 1,250-1,350 Wh | | 一般（上午/下午，约 5h） | ~100-150W avg → 500-750 W",
      "recallCount": 0,
      "dailyCount": 1,
      "groundedCount": 0,
      "totalScore": 0.58,
      "maxScore": 0.58,
      "firstRecalledAt": "2026-05-12T19:00:00.903Z",
      "lastRecalledAt": "2026-05-12T19:00:00.903Z",
      "queryHashes": [
        "0bd2888cfb05"
      ],
      "recallDays": [
        "2026-05-13",
        "2026-05-12"
      ],
      "conceptTags": [
