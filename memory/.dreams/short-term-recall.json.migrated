    "memory:memory/.dreams/session-corpus/2026-05-18.txt:75:75": {
      "key": "memory:memory/.dreams/session-corpus/2026-05-18.txt:75:75",
      "path": "memory/.dreams/session-corpus/2026-05-18.txt",
      "startLine": 75,
      "endLine": 75,
