        "250-270w",
        "250-1",
        "上午/下午",
        "100-150w",
        "500-750",
        "200w",
        "300w"
      ]
    },
    "memory:memory/.dreams/session-corpus/2026-05-10.txt:88:88": {
      "key": "memory:memory/.dreams/session-corpus/2026-05-10.txt:88:88",
      "path": "memory/.dreams/session-corpus/2026-05-10.txt",
      "startLine": 88,
      "endLine": 88,
      "source": "memory",
      "snippet": "Assistant: 鉛酸 absorption 電壓：14.4V 左右 - Float 電壓：13.5-13.8V - 確認 MPPT 有正確設定，不要過充 --- 目前 300W + 3顆鉛酸，應付 50W 持續負載**基本可行**，但蓄電池建議至少加到 4 顆會更穩妥。你目前的控制器是哪一台？",
      "recallCount": 0,
      "dailyCount": 1,
      "groundedCount": 0,
      "totalScore": 0.58,
      "maxScore": 0.58,
      "firstRecalledAt": "2026-05-12T19:00:00.903Z",
